<UserControl x:Class="NIVEX.Desktop.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{Binding Tx[profEyebrow]}" Style="{StaticResource Eyebrow}"/>
    <TextBlock Text="{Binding Tx[profTitle]}" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="{Binding Tx[profLead]}" Style="{StaticResource Lead}"/>
    <Border Style="{StaticResource Rule}"/>
    <ItemsControl ItemsSource="{Binding Items}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <RadioButton Style="{StaticResource ChoiceCard}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                       GroupName="ProfileChoice" Margin="0,0,10,10" MinWidth="150"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding Tx[profEmpty]}" Foreground="{StaticResource Faint}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"
               Visibility="{Binding NoProfiles, Converter={StaticResource BoolVis}}"/>
    <Button Content="{Binding Tx[profNew]}" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
    <TextBlock Text="{Binding Message}" Margin="0,0,0,10" TextWrapping="Wrap">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
          <Setter Property="Foreground" Value="{StaticResource Silver}"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsError}" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
    <StackPanel Visibility="{Binding HasEditor, Converter={StaticResource BoolVis}}">
      <Border Style="{StaticResource Rule}"/>
      <TextBlock Text="{Binding Tx[profName]}" Style="{StaticResource Caption}"/>
      <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Width="420" HorizontalAlignment="Left" Margin="0,0,0,14"/>
      <TextBlock Text="{Binding Tx[profDesc]}" Style="{StaticResource Caption}"/>
      <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" Width="420" HorizontalAlignment="Left" Margin="0,0,0,18"/>
      <TextBlock Text="{Binding Tx[profItems]}" Style="{StaticResource Caption}"/>
      <ItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,6">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource Silver}" FontSize="12" Margin="0,0,0,4"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"/>
                    <Button Grid.Column="1" Content="{Binding DataContext.Tx[browse], RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Command="{Binding BrowseCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Visibility="{Binding CanBrowse, Converter={StaticResource BoolVis}}"/>
                  </Grid>
                  <CheckBox Content="{Binding DataContext.Tx[enabled], RelativeSource={RelativeSource AncestorType=UserControl}}"
                            IsChecked="{Binding Enabled}" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <Button Content="{Binding DataContext.Tx[up], RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding UpCommand}" Style="{StaticResource Ghost}"/>
                  <Button Content="{Binding DataContext.Tx[down], RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DownCommand}" Style="{StaticResource Ghost}" Margin="0,4,0,0"/>
                  <Button Content="{Binding DataContext.Tx[remove], RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding RemoveCommand}" Style="{StaticResource Ghost}" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <WrapPanel Margin="0,10,0,0">
        <Button Content="{Binding Tx[profAddProgram]}" Command="{Binding AddItemCommand}" CommandParameter="Program" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
        <Button Content="{Binding Tx[profAddFolder]}" Command="{Binding AddItemCommand}" CommandParameter="Folder" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
        <Button Content="{Binding Tx[profAddUrl]}" Command="{Binding AddItemCommand}" CommandParameter="Url" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
      </WrapPanel>
      <TextBlock Text="{Binding Tx[profLinked]}" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
      <ItemsControl ItemsSource="{Binding WorkflowChoices}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton Style="{StaticResource ChoiceCard}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                         GroupName="ProfileWorkflow" Margin="0,0,10,10" MinWidth="150"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Style="{StaticResource Rule}" Margin="0,10,0,18"/>
      <WrapPanel>
        <Button Content="{Binding Tx[profRun]}" Command="{Binding RunCommand}" Margin="0,0,10,8"/>
        <Button Content="{Binding Tx[cancel]}" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8"
                Visibility="{Binding Running, Converter={StaticResource BoolVis}}"/>
        <Button Content="{Binding Tx[save]}" Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8"/>
        <Button Content="{Binding Tx[duplicate]}" Command="{Binding DuplicateCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8"/>
        <Button Content="{Binding Tx[delete]}" Command="{Binding DeleteCommand}" Style="{StaticResource Ghost}" Margin="0,0,10,8"/>
      </WrapPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
