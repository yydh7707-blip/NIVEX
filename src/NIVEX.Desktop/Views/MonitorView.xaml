<UserControl x:Class="NIVEX.Desktop.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NIVEX.Desktop">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <Style x:Key="MetricBlock" TargetType="StackPanel">
      <Setter Property="Width" Value="300"/>
      <Setter Property="Margin" Value="0,0,28,24"/>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{Binding Tx[monEyebrow]}" Style="{StaticResource Eyebrow}"/>
    <TextBlock Text="{Binding Tx[monTitle]}" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="{Binding Tx[monLead]}" Style="{StaticResource Lead}"/>
    <Border Style="{StaticResource Rule}"/>
    <WrapPanel>
      <StackPanel Style="{StaticResource MetricBlock}">
        <TextBlock Text="{Binding Tx[monCpu]}" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
        <TextBlock Text="{Binding CpuText}" FontSize="20" FontWeight="Medium" Margin="0,0,0,8"/>
        <local:Sparkline Values="{Binding CpuSeries}" Height="44" Stroke="{StaticResource Silver}"/>
      </StackPanel>
      <StackPanel Style="{StaticResource MetricBlock}">
        <TextBlock Text="{Binding Tx[monMem]}" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
        <TextBlock Text="{Binding MemText}" FontSize="20" FontWeight="Medium" Margin="0,0,0,8"/>
        <local:Sparkline Values="{Binding MemSeries}" Height="44" Stroke="{StaticResource Silver}"/>
      </StackPanel>
      <StackPanel Style="{StaticResource MetricBlock}">
        <TextBlock Text="{Binding Tx[monDisk]}" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
        <TextBlock Text="{Binding DiskText}" FontSize="20" FontWeight="Medium" Margin="0,0,0,8"/>
        <local:Sparkline Values="{Binding DiskSeries}" Height="44" Stroke="{StaticResource Silver}"/>
      </StackPanel>
      <StackPanel Style="{StaticResource MetricBlock}">
        <TextBlock Text="{Binding Tx[monGpu]}" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
        <TextBlock Text="{Binding GpuText}" FontSize="20" FontWeight="Medium" Margin="0,0,0,8"/>
        <local:Sparkline Values="{Binding GpuSeries}" Height="44" Stroke="{StaticResource Silver}"/>
      </StackPanel>
    </WrapPanel>
    <Border Style="{StaticResource Rule}" Margin="0,0,0,14"/>
    <WrapPanel>
      <StackPanel Style="{StaticResource MetricBlock}" Margin="0,0,28,14">
        <TextBlock Text="{Binding Tx[monNetwork]}" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
        <TextBlock Text="{Binding NetText}" FontWeight="Medium"/>
      </StackPanel>
      <StackPanel Style="{StaticResource MetricBlock}" Margin="0,0,28,14">
        <TextBlock Text="{Binding Tx[monCpuTemp]}" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
        <TextBlock Text="{Binding Tx[tempUnsupported]}" Foreground="{StaticResource Faint}" FontSize="12"/>
      </StackPanel>
      <StackPanel Style="{StaticResource MetricBlock}" Margin="0,0,28,14">
        <TextBlock Text="{Binding Tx[monGpuTemp]}" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
        <TextBlock Text="{Binding Tx[tempUnsupported]}" Foreground="{StaticResource Faint}" FontSize="12"/>
      </StackPanel>
    </WrapPanel>
    <TextBlock Foreground="{StaticResource Muted}" FontSize="12">
      <Run Text="{Binding StateText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Tx[monUpdated], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding UpdatedText, Mode=OneWay}"/>
    </TextBlock>
    <TextBlock Text="{Binding Tx[monHistory]}" Foreground="{StaticResource Faint}" FontSize="12" Margin="0,2,0,0"/>
    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" Margin="0,8,0,0"
               Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"/>
    <WrapPanel Margin="0,16,0,0">
      <Button Content="{Binding Tx[monSave]}" Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8"/>
    </WrapPanel>
    <TextBlock Text="{Binding Message}" Foreground="{StaticResource Silver}" Margin="0,4,0,0"/>
  </StackPanel>
</UserControl>
