<UserControl x:Class="NIVEX.Desktop.Views.FlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{Binding Tx[flowEyebrow]}" Style="{StaticResource Eyebrow}"/>
    <TextBlock Text="{Binding Tx[flowTitle]}" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="{Binding Tx[flowLead]}" Style="{StaticResource Lead}"/>
    <Border Style="{StaticResource Rule}"/>
    <TextBlock Text="{Binding Tx[flowList]}" Style="{StaticResource Caption}"/>
    <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <RadioButton Style="{StaticResource ChoiceCard}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                       GroupName="FlowChoice" Margin="0,0,10,10" MinWidth="150"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding Tx[flowSelect]}" Foreground="{StaticResource Faint}" FontSize="12" Margin="0,0,0,10"
               Visibility="{Binding NoEditor, Converter={StaticResource BoolVis}}"/>
    <WrapPanel Margin="0,0,0,6">
      <Button Content="{Binding Tx[new]}" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8"/>
      <Button Content="{Binding Tx[flowImport]}" Command="{Binding ImportCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8"/>
    </WrapPanel>
    <TextBlock Text="{Binding Message}" Margin="0,0,0,10" TextWrapping="Wrap">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
          <Setter Property="Foreground" Value="{StaticResource Silver}"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsError}" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
    <StackPanel Visibility="{Binding HasEditor, Converter={StaticResource BoolVis}}">
      <Border Style="{StaticResource Rule}"/>
      <TextBlock Text="{Binding Tx[flowName]}" Style="{StaticResource Caption}"/>
      <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" MaxWidth="560" HorizontalAlignment="Stretch" Margin="0,0,0,18"/>
      <TextBlock Text="{Binding Tx[flowSteps]}" Style="{StaticResource Caption}"/>
      <TextBlock Text="{Binding Tx[flowNoSteps]}" Foreground="{StaticResource Faint}" FontSize="12" Margin="0,4,0,8"
                 Visibility="{Binding NoSteps, Converter={StaticResource BoolVis}}"/>
      <ItemsControl ItemsSource="{Binding Steps}" Margin="0,6,0,6">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Index}" Foreground="{StaticResource Faint}" FontSize="12" Margin="0,4,0,0"/>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                  <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource Silver}" FontSize="12" Margin="0,0,0,4"/>
                  <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Margin="0,0,0,6"/>
                  <Grid Visibility="{Binding ShowInput, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"/>
                    <Button Grid.Column="1" Content="{Binding DataContext.Tx[browse], RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Command="{Binding BrowseCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Visibility="{Binding CanBrowse, Converter={StaticResource BoolVis}}"/>
                  </Grid>
                  <WrapPanel Margin="0,8,0,0">
                    <CheckBox Content="{Binding DataContext.Tx[enabled], RelativeSource={RelativeSource AncestorType=UserControl}}"
                              IsChecked="{Binding Enabled}" Margin="0,0,18,0"/>
                    <CheckBox Content="{Binding DataContext.Tx[continueOnError], RelativeSource={RelativeSource AncestorType=UserControl}}"
                              IsChecked="{Binding ContinueOnError}"/>
                  </WrapPanel>
                  <TextBlock Foreground="{Binding StateBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                             Visibility="{Binding HasState, Converter={StaticResource BoolVis}}">
                    <Run Text="{Binding StateText, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding StateMessage, Mode=OneWay}"/>
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Button Content="{Binding DataContext.Tx[up], RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding UpCommand}" Style="{StaticResource Ghost}"/>
                  <Button Content="{Binding DataContext.Tx[down], RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DownCommand}" Style="{StaticResource Ghost}" Margin="0,4,0,0"/>
                  <Button Content="{Binding DataContext.Tx[remove], RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding RemoveCommand}" Style="{StaticResource Ghost}" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding Tx[flowAdd]}" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
      <WrapPanel>
        <Button Content="{Binding Tx[step_OpenFolder]}" Command="{Binding AddStepCommand}" CommandParameter="OpenFolder" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
        <Button Content="{Binding Tx[step_OpenFile]}" Command="{Binding AddStepCommand}" CommandParameter="OpenFile" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
        <Button Content="{Binding Tx[step_OpenUrl]}" Command="{Binding AddStepCommand}" CommandParameter="OpenUrl" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
        <Button Content="{Binding Tx[step_LaunchProgram]}" Command="{Binding AddStepCommand}" CommandParameter="LaunchProgram" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
        <Button Content="{Binding Tx[step_Wait]}" Command="{Binding AddStepCommand}" CommandParameter="Wait" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
        <Button Content="{Binding Tx[step_Confirm]}" Command="{Binding AddStepCommand}" CommandParameter="Confirm" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
        <Button Content="{Binding Tx[step_CheckPrevious]}" Command="{Binding AddStepCommand}" CommandParameter="CheckPrevious" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
      </WrapPanel>
      <Border Style="{StaticResource Rule}" Margin="0,10,0,18"/>
      <WrapPanel>
        <Button Content="{Binding Tx[run]}" Command="{Binding RunCommand}" Margin="0,0,10,8"/>
        <Button Content="{Binding Tx[flowCancelRun]}" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8"
                Visibility="{Binding Running, Converter={StaticResource BoolVis}}"/>
        <Button Content="{Binding Tx[save]}" Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8"/>
        <Button Content="{Binding Tx[flowExport]}" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8"/>
        <Button Content="{Binding Tx[delete]}" Command="{Binding DeleteCommand}" Style="{StaticResource Ghost}" Margin="0,0,10,8"/>
      </WrapPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
