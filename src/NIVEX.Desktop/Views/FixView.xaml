<UserControl x:Class="NIVEX.Desktop.Views.FixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
  </UserControl.Resources>
  <Grid Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
    <Grid Visibility="{Binding IsOverview, Converter={StaticResource BoolVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,14">
        <TextBlock Text="{Binding Tx[fixEyebrow]}" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding Tx[fixTitle]}" Style="{StaticResource PageTitle}" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding Tx[fixLead]}" Foreground="{StaticResource Muted}" FontSize="13"/>
      </StackPanel>

      <Border Grid.Row="1" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}"
              BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <WrapPanel>
            <Button Content="{Binding Tx[quickScan]}" Command="{Binding QuickCommand}" MinHeight="42" Margin="0,0,8,6"/>
            <Button Content="{Binding Tx[fullScan]}" Command="{Binding FullCommand}" Style="{StaticResource SecondaryButton}" MinHeight="42" Margin="0,0,8,6"/>
            <Button Content="{Binding Tx[cancel]}" Command="{Binding CancelCommand}" Style="{StaticResource Ghost}" MinHeight="42" Margin="0,0,8,6"
                    Visibility="{Binding Busy, Converter={StaticResource BoolVis}}"/>
          </WrapPanel>
          <TextBlock Grid.Column="1" Text="{Binding AdminText}" Foreground="{StaticResource Muted}"
                     FontSize="12" VerticalAlignment="Center" Margin="12,0,0,6"/>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
            <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Tx[lastScan], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding LastScan, Mode=OneWay}"/>
              <Run Text=" · "/><Run Text="{Binding Tx[adminNote], Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Silver}" FontSize="12" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <ItemsControl Grid.Row="2" ItemsSource="{Binding Rows}" Margin="0,0,0,8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MinHeight="38" Margin="0,0,16,0">
              <Grid ToolTipService.ShowDuration="30000">
                <Grid.ToolTip>
                  <StackPanel MaxWidth="520">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AdviceText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                  </StackPanel>
                </Grid.ToolTip>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" Foreground="{Binding StatusBrush}" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Medium" FontSize="13"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="8,0"/>
                <Button Grid.Column="3" Content="{Binding DataContext.Tx[repair], RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Command="{Binding DataContext.RepairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" MinHeight="28" Padding="8,0"
                        Visibility="{Binding CanRepair, Converter={StaticResource BoolVis}}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <WrapPanel Grid.Row="3" Margin="0,4,0,0">
        <Button Content="{Binding Tx[exportReport]}" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}"
                MinHeight="40" Margin="0,0,8,0"/>
        <Button Content="{Binding Tx[runAll]}" Command="{Binding RunAllCommand}" MinHeight="40" Margin="0,0,8,0"/>
        <Button Content="{Binding Tx[fixDetails]}" Command="{Binding DetailsCommand}" Style="{StaticResource Ghost}" MinHeight="40"/>
      </WrapPanel>
    </Grid>

    <ScrollViewer Visibility="{Binding ShowDetails, Converter={StaticResource BoolVis}}"
                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
    <StackPanel>
    <Button Content="{Binding Tx[fixBack]}" Command="{Binding OverviewCommand}" Style="{StaticResource Ghost}"
            HorizontalAlignment="Left" Margin="0,0,0,18"/>
    <TextBlock Text="{Binding Tx[fixDetailsLead]}" Foreground="{StaticResource Muted}" Margin="0,0,0,18"/>
    <TextBlock Text="{Binding Tx[fixEyebrow]}" Style="{StaticResource Eyebrow}"/>
    <TextBlock Text="{Binding Tx[fixTitle]}" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="{Binding Tx[fixLead]}" Style="{StaticResource Lead}"/>
    <Border Style="{StaticResource Rule}"/>
    <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1"
            CornerRadius="10" Padding="20,18" Margin="0,0,0,18">
      <StackPanel>
        <WrapPanel Margin="0,0,0,6">
          <Button Content="{Binding Tx[quickScan]}" Command="{Binding QuickCommand}" MinHeight="50" Margin="0,0,10,10"/>
          <Button Content="{Binding Tx[fullScan]}" Command="{Binding FullCommand}" Style="{StaticResource SecondaryButton}" MinHeight="50" Margin="0,0,10,10"/>
          <Button Content="{Binding Tx[cancel]}" Command="{Binding CancelCommand}" Style="{StaticResource Ghost}" MinHeight="50" Margin="0,0,10,10"
                  Visibility="{Binding Busy, Converter={StaticResource BoolVis}}"/>
        </WrapPanel>
        <TextBlock Text="{Binding AdminText}" Foreground="{StaticResource Faint}" FontSize="12"/>
        <TextBlock Text="{Binding Tx[adminNote]}" Foreground="{StaticResource Faint}" FontSize="12" Margin="0,2,0,12"/>
        <TextBlock Foreground="{StaticResource Muted}" FontSize="12">
          <Run Text="{Binding Tx[lastScan], Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding LastScan, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock Text="{Binding Summary}" FontSize="16" FontWeight="Medium" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding Message}" Foreground="{StaticResource Silver}" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,14,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Glyph}" Foreground="{Binding StatusBrush}" FontSize="16" FontWeight="SemiBold"/>
              <StackPanel Grid.Column="1" Margin="0,0,16,0">
                <TextBlock Text="{Binding Title}" FontWeight="Medium"/>
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"
                           Visibility="{Binding HasMessage, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding AdviceText}" Foreground="{StaticResource Faint}" FontSize="12" Margin="0,3,0,0"
                           Visibility="{Binding HasAdvice, Converter={StaticResource BoolVis}}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" HorizontalAlignment="Right" FontSize="12"/>
                <Button Content="{Binding DataContext.Tx[repair], RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Command="{Binding DataContext.RepairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                        Visibility="{Binding CanRepair, Converter={StaticResource BoolVis}}"/>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Visibility="{Binding HasCompare, Converter={StaticResource BoolVis}}" Margin="0,26,0,0">
      <TextBlock Text="{Binding Tx[compareTitle]}" FontSize="15" FontWeight="Medium"/>
      <TextBlock Text="{Binding Tx[compareLead]}" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,8"/>
      <TextBlock Text="{Binding Compare}" Foreground="{StaticResource Silver}" TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Visibility="{Binding HasFindings, Converter={StaticResource BoolVis}}" Margin="0,26,0,0">
      <TextBlock Text="{Binding Tx[analysisTitle]}" FontSize="15" FontWeight="Medium"/>
      <TextBlock Text="{Binding Tx[analysisLead]}" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,6"/>
      <ItemsControl ItemsSource="{Binding Findings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
              <StackPanel>
                <WrapPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="Medium" Margin="0,0,12,0"/>
                  <TextBlock Text="{Binding Certainty}" Foreground="{StaticResource Silver}" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Risk}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                </WrapPanel>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                  <Run Text="{Binding DataContext.Tx[evidenceLabel], RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Evidence, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding HasRelated, Converter={StaticResource BoolVis}}">
                  <Run Text="{Binding DataContext.Tx[relatedLabel], RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Related, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Advice}" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Visibility="{Binding HasRecurringIssues, Converter={StaticResource BoolVis}}" Margin="0,26,0,0">
      <TextBlock Text="{Binding Tx[recurringTitle]}" FontSize="15" FontWeight="Medium"/>
      <TextBlock Text="{Binding Tx[recurringLead]}" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,6"/>
      <ItemsControl ItemsSource="{Binding RecurringIssues}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="Medium"/>
                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Button Content="{Binding Tx[exportReport]}" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}"
            HorizontalAlignment="Left" Margin="0,18,0,0"/>
    <Button Content="{Binding Tx[runAll]}" Command="{Binding RunAllCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>

    <Border Style="{StaticResource Rule}" Margin="0,26,0,16"/>
    <TextBlock Text="{Binding Tx[advancedTitle]}" FontSize="15" FontWeight="Medium"/>
    <TextBlock Text="{Binding Tx[advancedLead]}" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,10"/>
    <WrapPanel>
      <Button Content="{Binding Tx[errorsBtn]}" Command="{Binding ErrorsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
      <Button Content="{Binding Tx[largeBtn]}" Command="{Binding LargeCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
    </WrapPanel>
    <TextBlock Text="{Binding DiagNote}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
    <ItemsControl ItemsSource="{Binding Errors}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="0,4">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl ItemsSource="{Binding Large}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="0,4">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel x:Name="ExtrasRoot" DataContext="{Binding Extras}">
      <TextBlock Text="{Binding Note}" Foreground="{StaticResource Silver}" TextWrapping="Wrap" Margin="0,10,0,0"/>

      <Border Style="{StaticResource Rule}" Margin="0,22,0,16"/>
      <TextBlock Text="{Binding Tx[startupBtn]}" FontSize="15" FontWeight="Medium"/>
      <TextBlock Text="{Binding Tx[startupNote]}" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,10"/>
      <WrapPanel>
        <Button Content="{Binding Tx[startupBtn]}" Command="{Binding LoadStartupCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
        <Button Content="{Binding Tx[undoBtn]}" Command="{Binding UndoCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
      </WrapPanel>
      <ItemsControl ItemsSource="{Binding Startup}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap">
                  <Run Text="{Binding Detail, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding State, Mode=OneWay}"/>
                </TextBlock>
              </StackPanel>
              <Button Grid.Column="1" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Style="{StaticResource SecondaryButton}"
                      VerticalAlignment="Center" Visibility="{Binding CanToggle, Converter={StaticResource BoolVis}}"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource Rule}" Margin="0,22,0,16"/>
      <TextBlock Text="{Binding Tx[devBtn]}" FontSize="15" FontWeight="Medium"/>
      <WrapPanel Margin="0,8,0,0">
        <Button Content="{Binding Tx[devBtn]}" Command="{Binding DevicesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
        <Button Content="{Binding Tx[devMgrBtn]}" Command="{Binding DeviceManagerCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
      </WrapPanel>
      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,4">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource Rule}" Margin="0,22,0,16"/>
      <TextBlock Text="{Binding Tx[netAdvTitle]}" FontSize="15" FontWeight="Medium"/>
      <TextBlock Text="{Binding Tx[netAdvLead]}" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,10"/>
      <WrapPanel>
        <Button Content="Winsock" Command="{Binding NetRepairCommand}" CommandParameter="winsock" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
        <Button Content="TCP/IP" Command="{Binding NetRepairCommand}" CommandParameter="tcpip" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
      </WrapPanel>

      <Border Style="{StaticResource Rule}" Margin="0,22,0,16"/>
      <TextBlock Text="{Binding Tx[appTitle]}" FontSize="15" FontWeight="Medium"/>
      <TextBlock Text="{Binding Tx[appLead]}" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,10"/>
      <Button Content="{Binding Tx[appBtn]}" Command="{Binding AppCheckCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
      <ItemsControl ItemsSource="{Binding AppRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,4">
              <TextBlock Text="{Binding Title}" Foreground="{Binding Brush}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource Rule}" Margin="0,22,0,16"/>
      <TextBlock Text="{Binding Tx[profileTitle]}" FontSize="15" FontWeight="Medium"/>
      <TextBlock Text="{Binding Tx[profileLead]}" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,10"/>
      <ItemsControl ItemsSource="{Binding Profiles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding Name}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"
                    Command="{Binding DataContext.SelectProfileCommand, ElementName=ExtrasRoot}" CommandParameter="{Binding}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Foreground="{StaticResource Silver}" Margin="0,0,0,6"><Run Text="▸ "/><Run Text="{Binding SelectedName, Mode=OneWay}"/></TextBlock>
      <ItemsControl ItemsSource="{Binding ProfileChecks}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,0,18,6"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <TextBlock Text="{Binding Tx[intervalLabel]}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Text="{Binding Interval, UpdateSourceTrigger=LostFocus}" Width="60"/>
      </StackPanel>
      <CheckBox Content="{Binding Tx[scheduleChk]}" IsChecked="{Binding ScheduleOn, Mode=TwoWay}" Margin="0,10,0,0"/>
      <TextBlock Text="{Binding ScheduleNote}" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,10"/>
      <WrapPanel>
        <Button Content="{Binding Tx[mpRun]}" Command="{Binding RunProfileCommand}" Margin="0,0,10,10"/>
        <Button Content="{Binding Tx[profDup]}" Command="{Binding DuplicateCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
        <Button Content="{Binding Tx[profDel]}" Command="{Binding DeleteProfileCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"/>
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,10,0"/>
        <Button Content="{Binding Tx[profNew]}" Command="{Binding NewProfileCommand}" Style="{StaticResource SecondaryButton}"/>
      </StackPanel>
      <ItemsControl ItemsSource="{Binding ProfileResults}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,4">
              <TextBlock Text="{Binding Title}" Foreground="{Binding Brush}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
