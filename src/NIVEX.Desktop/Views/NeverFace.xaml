<UserControl x:Class="NIVEX.Desktop.Views.NeverFace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="NEVER mascot face">
  <Viewbox Stretch="Uniform">
    <Grid Width="132" Height="132">
      <Border Margin="2,2,2,1" CornerRadius="66" BorderThickness="1.5" BorderBrush="#FF596267">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF25292C" Offset="0"/>
            <GradientStop Color="#FF080A0B" Offset="0.35"/>
            <GradientStop Color="#FF101315" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.16"/>
        </Border.Effect>
      </Border>
      <Border Margin="7,8,7,7" CornerRadius="59" Background="#FF030405" BorderBrush="#FF141719" BorderThickness="1"/>
      <Grid Margin="28,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="LeftEye" Width="16" Height="25" Fill="#FFF8FAFB" HorizontalAlignment="Center" VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform>
            <ScaleTransform x:Name="LeftEyeScale" ScaleY="1"/>
          </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="RightEye" Grid.Column="1" Width="16" Height="25" Fill="#FFF8FAFB" HorizontalAlignment="Center" VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform>
            <ScaleTransform x:Name="RightEyeScale" ScaleY="1"/>
          </Ellipse.RenderTransform>
        </Ellipse>
      </Grid>
    </Grid>
  </Viewbox>
</UserControl>
