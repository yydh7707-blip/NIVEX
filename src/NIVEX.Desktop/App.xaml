<Application x:Class="NIVEX.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#050506"/>
    <SolidColorBrush x:Key="Ink" Color="#F6F7F8"/>
    <SolidColorBrush x:Key="Muted" Color="#9AA3AD"/>
    <SolidColorBrush x:Key="Faint" Color="#636D78"/>
    <SolidColorBrush x:Key="Danger" Color="#E8C9C4"/>
    <SolidColorBrush x:Key="Line" Color="#33FFFFFF"/>
    <LinearGradientBrush x:Key="FrameBorder" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#55FFFFFF" Offset="0"/>
      <GradientStop Color="#18FFFFFF" Offset="0.45"/>
      <GradientStop Color="#30E8EEF5" Offset="0.65"/>
      <GradientStop Color="#40FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Surface" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#12141A" Offset="0"/>
      <GradientStop Color="#0A0B0E" Offset="1"/>
    </LinearGradientBrush>
    <Duration x:Key="Dur">0:0:0.28</Duration>
    <QuadraticEase x:Key="EaseOut" EasingMode="EaseOut"/>

    <Style x:Key="SurfaceCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="26"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource FrameBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="MetricTile" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="MinWidth" Value="148"/>
    </Style>

    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource Bg}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#14000000"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="#88FFFFFF"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#14000000"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="#88FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Ink}"/>
      <Setter Property="Foreground" Value="#0A0B0C"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Opacity" Value="0.92"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0FFFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="#44FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#12FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>
  </Application.Resources>
</Application>
