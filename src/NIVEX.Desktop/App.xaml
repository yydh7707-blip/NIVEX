<Application x:Class="NIVEX.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#000000"/>
    <SolidColorBrush x:Key="Ink" Color="#F7F8F9"/>
    <SolidColorBrush x:Key="Muted" Color="#B7BFC8"/>
    <SolidColorBrush x:Key="Faint" Color="#8B949E"/>
    <SolidColorBrush x:Key="Danger" Color="#F0D2CC"/>
    <SolidColorBrush x:Key="Line" Color="#3C434C"/>
    <SolidColorBrush x:Key="Silver" Color="#C5CCD4"/>
    <SolidColorBrush x:Key="SurfaceBase" Color="#0B0C0E"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#121417"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#1A1D21"/>
    <SolidColorBrush x:Key="FocusEdge" Color="#D8DDE2"/>
    <Duration x:Key="MotionQuick">0:0:0.12</Duration>
    <Duration x:Key="MotionStandard">0:0:0.2</Duration>
    <Duration x:Key="MotionPage">0:0:0.28</Duration>
    <LinearGradientBrush x:Key="FrameBorder" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#66FFFFFF" Offset="0"/>
      <GradientStop Color="#22FFFFFF" Offset="0.42"/>
      <GradientStop Color="#55D5DCE4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Surface" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#14161A" Offset="0"/>
      <GradientStop Color="#0C0E11" Offset="1"/>
    </LinearGradientBrush>
    <Duration x:Key="Dur">0:0:0.16</Duration>

    <Style x:Key="SurfaceCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="24"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource FrameBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="MetricTile" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="MinWidth" Value="148"/>
    </Style>

    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource Bg}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F7F8F9"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/>
      <Setter Property="SelectionBrush" Value="#3A4652"/>
      <Setter Property="SelectionTextBrush" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="MinHeight" Value="46"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" CornerRadius="8" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
              <Border.Background>
                <SolidColorBrush x:Name="Fill" Color="#101216"/>
              </Border.Background>
              <Border.BorderBrush>
                <SolidColorBrush x:Name="Edge" Color="#4A525C"/>
              </Border.BorderBrush>
              <Border.BorderThickness>1</Border.BorderThickness>
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#7E8791"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Color" To="#F4F6F8" Duration="0:0:0.16"/>
                      <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#171A1F" Duration="0:0:0.16"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Color" To="#4A525C" Duration="0:0:0.16"/>
                      <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#101216" Duration="0:0:0.16"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
              <Trigger Property="Validation.HasError" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#D8B9B3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="PasswordBox">
      <Setter Property="Foreground" Value="#F7F8F9"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/>
      <Setter Property="SelectionBrush" Value="#3A4652"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="MinHeight" Value="46"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Bd" CornerRadius="8" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
              <Border.Background>
                <SolidColorBrush x:Name="Fill" Color="#101216"/>
              </Border.Background>
              <Border.BorderBrush>
                <SolidColorBrush x:Name="Edge" Color="#4A525C"/>
              </Border.BorderBrush>
              <Border.BorderThickness>1</Border.BorderThickness>
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#7E8791"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Color" To="#F4F6F8" Duration="0:0:0.16"/>
                      <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#171A1F" Duration="0:0:0.16"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Color" To="#4A525C" Duration="0:0:0.16"/>
                      <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#101216" Duration="0:0:0.16"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#111214"/>
      <Setter Property="Background" Value="#F7F8F9"/>
      <Setter Property="BorderBrush" Value="#F7F8F9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="MinHeight" Value="46"/>
      <Setter Property="MinWidth" Value="112"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}"
                    BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,1">
              <Border.Background>
                <SolidColorBrush x:Name="Fill" Color="#F7F8F9"/>
              </Border.Background>
              <Border.BorderBrush>
                <SolidColorBrush x:Name="Edge" Color="#F7F8F9"/>
              </Border.BorderBrush>
              <Border.RenderTransform>
                <TranslateTransform x:Name="Shift"/>
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal">
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#F7F8F9" Duration="{StaticResource MotionStandard}"/>
                      <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource MotionStandard}"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#E4E7EB" Duration="{StaticResource MotionStandard}"/>
                      <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="Y" To="-1" Duration="{StaticResource MotionStandard}"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#D3D7DC" Duration="{StaticResource MotionQuick}"/>
                      <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource MotionQuick}"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled"/>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.42"/>
        </Trigger>
        <DataTrigger Binding="{Binding Busy}" Value="True">
          <Setter Property="Opacity" Value="1"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="#F4F6F8"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}"
                    BorderThickness="1" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,1">
              <Border.Background>
                <SolidColorBrush x:Name="Fill" Color="#101216"/>
              </Border.Background>
              <Border.BorderBrush>
                <SolidColorBrush x:Name="Edge" Color="#A8B1BB"/>
              </Border.BorderBrush>
              <Border.RenderTransform>
                <TranslateTransform x:Name="Shift"/>
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal">
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#101216" Duration="{StaticResource MotionStandard}"/>
                      <ColorAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Color" To="#A8B1BB" Duration="{StaticResource MotionStandard}"/>
                      <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource MotionStandard}"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#1A1D22" Duration="{StaticResource MotionStandard}"/>
                      <ColorAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Color" To="#E4E8ED" Duration="{StaticResource MotionStandard}"/>
                      <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="Y" To="-1" Duration="{StaticResource MotionStandard}"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Color" To="#0C0D10" Duration="{StaticResource MotionQuick}"/>
                      <ColorAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Color" To="#F4F6F8" Duration="{StaticResource MotionQuick}"/>
                      <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource MotionQuick}"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled"/>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1A1D22"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#D5DCE3"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0E1013"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Background" Value="#101216"/>
      <Setter Property="BorderBrush" Value="#8E98A3"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#14FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#D5DBE1"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,12,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center" SnapsToDevicePixels="True" BorderThickness="1" Background="#101216" BorderBrush="#8E98A3">
                <Path x:Name="Mark" Data="M3,9 L7,13 L15,4" Stroke="#111214" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stretch="Uniform" Margin="3" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#F4F6F8"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#F4F6F8"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#F4F6F8"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
